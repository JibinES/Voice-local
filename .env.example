# =============================================================================
# Voice Bot - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
#
# REQUIRED: You MUST set HF_TOKEN before running setup.sh
# Everything else has sensible defaults for an RTX 5090 (32GB).
# =============================================================================

# ---------------------------------------------------------------------------
# [REQUIRED] Hugging Face Token
# ---------------------------------------------------------------------------
# Needed to download model weights. Get yours at:
#   https://huggingface.co/settings/tokens
# Use a token with "Read" access. Some models (e.g. gated repos) won't
# download without it, and public downloads get rate-limited without one.
HF_TOKEN=hf_your_token_here

# ---------------------------------------------------------------------------
# GPU Configuration
# ---------------------------------------------------------------------------
# Which GPU(s) to expose to containers. "all" uses every available GPU.
# For multi-GPU systems, set to a specific device index (e.g., "0").
NVIDIA_VISIBLE_DEVICES=all
CUDA_VISIBLE_DEVICES=0

# ---------------------------------------------------------------------------
# Service Ports
# ---------------------------------------------------------------------------
# Change these if you have port conflicts on the host.
LLM_PORT=8000        # vLLM OpenAI-compatible API
ASR_PORT=8001        # faster-whisper-server (OpenAI Whisper API)
TTS_PORT=8002        # svara-TTS FastAPI
TTS_VLLM_INTERNAL_PORT=8003  # svara-TTS internal vLLM (not exposed to host)
ORCHESTRATOR_PORT=9000       # Pipecat voice pipeline + WebSocket
UI_PORT=3000                 # Browser test UI

# ---------------------------------------------------------------------------
# LLM Service (vLLM — GPT-OSS-20B)
# ---------------------------------------------------------------------------
LLM_MODEL_NAME=openai/gpt-oss-20b
LLM_SERVED_MODEL_NAME=gpt-oss-20b
# Fraction of total GPU memory vLLM reserves. 0.46875 = 15GB on a 32GB GPU.
# Lower this if you get OOM errors; raise it for more KV-cache (longer context).
LLM_GPU_MEMORY_UTILIZATION=0.46875
LLM_MAX_MODEL_LEN=4096

# ---------------------------------------------------------------------------
# TTS Service (svara-TTS v1)
# ---------------------------------------------------------------------------
TTS_MODEL_NAME=kenpath/svara-tts-v1
# GPU memory fraction for svara's internal vLLM. 0.2 = ~6.4GB on 32GB.
TTS_GPU_MEMORY_UTILIZATION=0.2
TTS_MAX_MODEL_LEN=2048
# Default voice: {language}_{gender}. Options:
#   hi_female, hi_male, ml_female, ml_male, ta_female, ta_male,
#   te_female, te_male, kn_female, kn_male, en_female, en_male
TTS_DEFAULT_VOICE=hi_female

# ---------------------------------------------------------------------------
# ASR Service (faster-whisper-server — IndicWhisper)
# ---------------------------------------------------------------------------
ASR_COMPUTE_TYPE=int8
ASR_DEVICE=cuda

# ---------------------------------------------------------------------------
# Model Paths (inside the shared Docker volume, mounted at /models)
# ---------------------------------------------------------------------------
# You should NOT need to change these unless you renamed models.
ASR_MODEL_PATH=/models/indicwhisper-ct2
TTS_MODEL_PATH=/models/svara-tts-v1
LLM_MODEL_PATH=/models/gpt-oss-20b

# ---------------------------------------------------------------------------
# Docker Volume
# ---------------------------------------------------------------------------
# Name of the Docker volume that stores downloaded model weights.
# Created automatically by setup.sh.
MODEL_VOLUME=voice-bot-models
